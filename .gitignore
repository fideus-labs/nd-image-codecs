/target
Cargo.lock.orig

# rustc internal-compiler-error crash dumps (written to CWD on an ICE).
rustc-ice-*.txt

.pixi/
pixi.lock

# Python
__pycache__/
*.egg-info/
*.pyc
dist/
*.whl
.venv/
# maturin develop drops the native extension into the source tree
*.abi3.so

# TypeScript / Node
node_modules/
bindings/typescript/dist/
bindings/typescript/pkg/
bindings/typescript/src/wasm/
*.wasm

# Benchmark working artifacts. Per-run JSON records and the browser
# viewer's static-site bundle land under `target/benchmarks/` (which
# is also covered by the top-level `/target` rule above, but the
# explicit entry here keeps the bench/CI intent obvious). The named
# baselines that the `bench-pr-gate.yml` workflow diffs against live
# under `bench/baselines/` and *are* committed.
target/benchmarks/
bench/viewer/dist/
bench/viewer/node_modules/

# MyST documentation site build output. `myst build --html` writes the
# rendered static site (plus its intermediate AST cache) under
# `docs/_build/`; the site is rebuilt from `docs/myst.yml` and the
# markdown tree on every run, so nothing in here is committed. The
# toolchain itself is pinned by `docs/package-lock.json`, which *is*
# committed. `docs/node_modules/` is already covered by the
# `node_modules/` rule above.
docs/_build/

# Test / conformance data caches (downloaded, not vendored)
test-data/cache/
*.jph.tmp
*.j2c.tmp

# Editor / agent scratch
.serena/
.claude/*
!.claude/skills/
.maestro/

.coverage
