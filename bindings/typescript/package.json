{
  "name": "@fideus-labs/nd-image-codecs",
  "version": "0.0.2",
  "description": "Composable Zarr v3 codecs (nd-delta, nd-lift-ht, nd-zfp) for ND scientific images — cross-axis lifting, HTJ2K coefficient planes, and ZFP, with an axis-aware codec-series builder (WebAssembly).",
  "license": "MIT",
  "author": "Fideus Labs LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/fideus-labs/nd-image-codecs.git",
    "directory": "bindings/typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/ndic-zarr --target web --out-dir ../../bindings/typescript/src/wasm -- --features wasm",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');if(fs.existsSync('src/wasm'))fs.cpSync('src/wasm','dist/wasm',{recursive:true})\"",
    "test": "vitest run"
  },
  "keywords": [
    "htj2k",
    "jpeg2000",
    "zfp",
    "zarr",
    "numcodecs",
    "zarrita",
    "wasm",
    "compression",
    "ome-ngff"
  ],
  "devDependencies": {
    "@zarrita/storage": "^0.2.0",
    "tsx": "^4.23.5",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "zarrita": "^0.7.3"
  }
}
