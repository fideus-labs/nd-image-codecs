{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "nd_zfp"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "dims": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "reversible"
            },
            "dims": true
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "properties": {
            "mode": {
              "const": "fixed_rate"
            },
            "rate": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dims": true
          },
          "required": ["mode", "rate"],
          "additionalProperties": false
        },
        {
          "properties": {
            "mode": {
              "const": "fixed_accuracy"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            },
            "dims": true
          },
          "required": ["mode", "tolerance"],
          "additionalProperties": false
        },
        {
          "properties": {
            "mode": {
              "const": "fixed_precision"
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "dims": true
          },
          "required": ["mode", "precision"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["name"],
  "additionalProperties": false
}
